# Where the Express API runs (used by Next rewrites and server-side fetches).
# Must be set both when running `next build` and at runtime — Next inlines rewrite
# destinations at build time, so a value that only exists at runtime has no effect.
SERVER_API_URL=http://localhost:4000
# Shown on the About page for removal requests
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional shared secret sent as `x-manix-internal` on every server-side fetch to the API, so
# those fetches skip the API's per-IP rate limits. Must match the API's INTERNAL_API_TOKEN.
# Server-only: do not prefix with NEXT_PUBLIC_.
INTERNAL_API_TOKEN=
